generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum AccountType {
  TALENT
  INSTITUTION
}

enum PremiumPlan {
  TALENT_PREMIUM
  INSTITUTION_PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum OpportunityStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SELECTED
  REJECTED
}

enum NotificationType {
  NEW_OPPORTUNITY
  NEW_APPLICATION
  APPLICATION_UPDATE
  PROFESSIONAL_INVITATION
  INVITATION_RESPONSE
  CHAT_MESSAGE
}
model User {
  id String @id @default(uuid())
  email String @unique
  username String @unique
  passwordHash String
  accountType AccountType @default(TALENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile Profile?
  subscription Subscription?
  institutionProfile InstitutionProfile?
  likesSent Like[] @relation("LikesSent")
  likesReceived Like[] @relation("LikesReceived")
  matchesA Match[] @relation("MatchUserA")
  matchesB Match[] @relation("MatchUserB")
  messages Message[]
  institutionFavorites InstitutionFavorite[] @relation("InstitutionFavorites")
  savedByInstitutions InstitutionFavorite[] @relation("FavoriteTalent")
  sentInvitations ProfessionalInvitation[] @relation("InstitutionInvitations")
  receivedInvitations ProfessionalInvitation[] @relation("TalentInvitations")
  postedOpportunities Opportunity[]
  applications Application[] @relation("TalentApplications")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationActor")
}
model Profile {
  id String @id @default(uuid())
  userId String @unique
  displayName String
  bio String? @db.VarChar(500)
  birthDate DateTime?
  city String?
  vocalRegister String?
  gender String?
  languages String[] @default([])
  experience String?
  repertoire String[] @default([])
  interests String[] @default([])
  photoUrl String?
  media ProfileMedia[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model InstitutionProfile {
  id String @id @default(uuid())
  userId String @unique
  name String
  type String
  description String? @db.VarChar(1000)
  city String?
  country String?
  website String?
  logoUrl String?
  specialties String[] @default([])
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model ProfileMedia {
  id String @id @default(uuid())
  profileId String
  url String
  type String
  fileName String?
  createdAt DateTime @default(now())
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId, createdAt])
}
model Like {
  id String @id @default(uuid())
  fromUserId String
  toUserId String
  createdAt DateTime @default(now())
  fromUser User @relation("LikesSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser User @relation("LikesReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}
model Match {
  id String @id @default(uuid())
  userAId String
  userBId String
  createdAt DateTime @default(now())
  userA User @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation Conversation?
  @@unique([userAId, userBId])
}
model Conversation {
  id String @id @default(uuid())
  matchId String? @unique
  invitationId String? @unique
  createdAt DateTime @default(now())
  match Match? @relation(fields: [matchId], references: [id], onDelete: Cascade)
  invitation ProfessionalInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  messages Message[]
}
model Message {
  id String @id @default(uuid())
  conversationId String
  senderId String
  content String @db.VarChar(2000)
  readAt DateTime?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
  @@index([conversationId, senderId, readAt])
}

model InstitutionFavorite {
  id            String   @id @default(uuid())
  institutionId String
  talentId      String
  createdAt     DateTime @default(now())
  institution   User     @relation("InstitutionFavorites", fields: [institutionId], references: [id], onDelete: Cascade)
  talent        User     @relation("FavoriteTalent", fields: [talentId], references: [id], onDelete: Cascade)

  @@unique([institutionId, talentId])
  @@index([talentId])
}

model ProfessionalInvitation {
  id String @id @default(uuid())
  institutionId String
  talentId String
  title String @db.VarChar(120)
  message String @db.VarChar(2000)
  status InvitationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institution User @relation("InstitutionInvitations", fields: [institutionId], references: [id], onDelete: Cascade)
  talent User @relation("TalentInvitations", fields: [talentId], references: [id], onDelete: Cascade)
  conversation Conversation?
  @@index([institutionId, createdAt])
  @@index([talentId, status, createdAt])
}

model Opportunity {
  id String @id @default(uuid())
  institutionId String
  title String @db.VarChar(140)
  description String @db.VarChar(3000)
  type String @db.VarChar(40)
  vocalRegisters String[] @default([])
  requirements String? @db.VarChar(2000)
  city String?
  country String?
  deadline DateTime?
  status OpportunityStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institution User @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  applications Application[]
  @@index([status, deadline, createdAt])
  @@index([institutionId, createdAt])
}

model Application {
  id String @id @default(uuid())
  opportunityId String
  talentId String
  message String? @db.VarChar(2000)
  status ApplicationStatus @default(SUBMITTED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  talent User @relation("TalentApplications", fields: [talentId], references: [id], onDelete: Cascade)
  @@unique([opportunityId, talentId])
  @@index([talentId, createdAt])
  @@index([opportunityId, status, createdAt])
}

model Notification {
  id String @id @default(uuid())
  recipientId String
  actorId String?
  type NotificationType
  title String @db.VarChar(160)
  message String @db.VarChar(500)
  link String?
  readAt DateTime?
  createdAt DateTime @default(now())
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([recipientId, readAt, createdAt])
}

model Subscription {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  plan                   PremiumPlan
  status                 SubscriptionStatus @default(TRIALING)
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, currentPeriodEnd])
}
